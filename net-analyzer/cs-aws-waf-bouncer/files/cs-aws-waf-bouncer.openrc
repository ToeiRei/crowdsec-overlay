#!/sbin/openrc-run

name="CrowdSec AWS WAF bouncer"
description="CrowdSec AWS WAF bouncer"

bouncer_config="${bouncer_config:-/etc/crowdsec/crowdsec-aws-waf-bouncer.yaml}"
lapi_init_service="${lapi_init_service:-crowdsec}"

command="/usr/bin/crowdsec-aws-waf-bouncer"
command_args="-c ${bouncer_config}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
notify="socket:ready"
required_files="${bouncer_config}"

extra_commands="checkconfig"
description_checkconfig="Validate the CrowdSec AWS WAF bouncer configuration"

depend() {
	need net
	if [ "${lapi_init_service}" != "none" ]; then
		need "${lapi_init_service}"
	fi
}

checkconfig() {
	ebegin "Checking CrowdSec AWS WAF bouncer configuration"
	"${command}" -c "${bouncer_config}" -t
	eend $?
}

start_pre() {
	rm -f "${RC_SVCDIR}/supervise-${RC_SVCNAME}.sock" || return 1
	checkconfig
}
