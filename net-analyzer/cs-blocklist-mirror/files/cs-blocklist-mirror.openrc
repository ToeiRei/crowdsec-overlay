#!/sbin/openrc-run

name="CrowdSec blocklist mirror"
description="CrowdSec blocklist mirror"

bouncer_config="${bouncer_config:-/etc/crowdsec/crowdsec-blocklist-mirror.yaml}"
lapi_init_service="${lapi_init_service:-crowdsec}"

command="/usr/bin/crowdsec-blocklist-mirror"
command_args="-c ${bouncer_config}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
notify="socket:ready"
required_files="${bouncer_config}"

extra_commands="checkconfig"
description_checkconfig="Validate the CrowdSec blocklist mirror configuration"

depend() {
	if [ "${lapi_init_service}" != "none" ]; then
		need "${lapi_init_service}"
	fi
}

checkconfig() {
	ebegin "Checking CrowdSec blocklist mirror configuration"
	"${command}" -c "${bouncer_config}" -t
	eend $?
}

start_pre() {
	rm -f "${RC_SVCDIR}/supervise-${RC_SVCNAME}.sock" || return 1
	checkconfig
}
