#!/sbin/openrc-run

name="CrowdSec firewall bouncer"
description="CrowdSec firewall bouncer"

bouncer_config="${bouncer_config:-/etc/crowdsec/crowdsec-firewall-bouncer.yaml}"
lapi_init_service="${lapi_init_service:-crowdsec}"
firewall_init_service="${firewall_init_service:-nftables}"

command="/usr/bin/crowdsec-firewall-bouncer"
command_args="-c ${bouncer_config}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
notify="socket:ready"
required_files="${bouncer_config}"

extra_commands="checkconfig"
description_checkconfig="Validate the CrowdSec firewall bouncer configuration"

depend() {
	if [ "${lapi_init_service}" != "none" ]; then
		need "${lapi_init_service}"
	fi
	if [ "${firewall_init_service}" != "none" ]; then
		use "${firewall_init_service}"
	fi
}

checkconfig() {
	ebegin "Checking CrowdSec firewall bouncer configuration"
	"${command}" -c "${bouncer_config}" -t
	eend $?
}

# The bouncer's -t option initializes its firewall backend. Run it only from
# start_pre, after any previous bouncer process has stopped.
start_pre() {
	rm -f "${RC_SVCDIR}/supervise-${RC_SVCNAME}.sock" || return 1
	checkconfig
}
